# ========================================================
# APIChat Hub - Environment Variables Configuration
# Copy this file to '.env' on your Hostinger server
# ========================================================

# 1. Server Environment & Port
# (Hostinger Cloud / VPS or Node.js App usually sets PORT automatically)
PORT=3000
NODE_ENV=production

# 2. Website Admin Login Credentials
# (Controls access to the web dashboard and proxy routes)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# 3. Telegram Bot Integration (Optional but Recommended for 24/7 Auto-Start)
# Token obtained from @BotFather on Telegram (e.g. 7123456789:AAFx...)
# If specified, the bot connects automatically when the server boots!
TELEGRAM_BOT_TOKEN=

# 4. Telegram Bot Owner ID (Designated Full Admin)
# The Telegram user ID with unlimited quota and authorization rights
TELEGRAM_OWNER_ID=2051992452

# 5. Default Target API Configuration
# The endpoint queried when users send a 10-digit number
DEFAULT_API_URL=https://rootx-osint.in/?type=num&key=sachin&query={number}
DEFAULT_PARAM_NAME=number

# 6. Lock API on Startup (true/false)
# If true, locks the API configuration so it cannot be tampered with
LOCK_API=true
